# Kopyala -> .env  ve doldur.

# ==== SAGLAYICI: "cloud" (Groq+Gemini) veya "ollama" (tamamen yerel) ====
PROVIDER=cloud

# --- cloud modu icin ---
GROQ_API_KEY=buraya_groq_anahtarin
GEMINI_API_KEY=buraya_gemini_anahtarin
LLM_MODEL=llama-3.3-70b-versatile
VLM_MODEL=gemini-3.5-flash

# --- ollama modu icin (once: ollama pull llama3.1:8b && ollama pull qwen2.5vl:7b) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_VLM_MODEL=qwen2.5vl:7b
